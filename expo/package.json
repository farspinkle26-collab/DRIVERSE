{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "bunx rork start -p b1wgosfqgvf871n3ggg51",
    "start-web": "bunx rork start -p b1wgosfqgvf871n3ggg51 --web",
    "start-web-dev": "DEBUG=expo* bunx rork start -p b1wgosfqgvf871n3ggg51 --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "bundle:ios": "expo export:embed --platform ios --dev false --entry-file node_modules/expo-router/entry.js --bundle-output /tmp/driverse-ios.bundle.js --assets-dest /tmp/driverse-ios-assets",
    "bundle:android": "expo export:embed --platform android --dev false --entry-file node_modules/expo-router/entry.js --bundle-output /tmp/driverse-android.bundle.js --assets-dest /tmp/driverse-android-assets",
    "bundle:hermes": "node scripts/hermes-compile.js /tmp/driverse-ios.bundle.js --out /tmp/driverse-ios.hbc",
    "bundle:hermes:android": "node scripts/hermes-compile.js /tmp/driverse-android.bundle.js --out /tmp/driverse-android.hbc",
    "check:versions": "node scripts/check-sdk-versions.js",
    "check:launch-path": "node scripts/check-launch-path.js /tmp/driverse-ios.bundle.js /tmp/driverse-android.bundle.js",
    "bundle:verify": "bun run check:versions && bun run bundle:ios && bun run bundle:android && bun run bundle:hermes && bun run bundle:hermes:android && bun run check:launch-path",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:functions": "bun test supabase/functions",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
