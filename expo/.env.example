# RevenueCat — publishable SDK keys, safe in the app bundle (the secret key
# lives only on the revenuecat-webhook edge function's server side). One key
# per platform is normal; during early testing before per-store keys exist,
# the same key can be set for both.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
