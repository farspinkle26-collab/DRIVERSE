# Driveverse mobile app — environment variables
# Copy to `.env` (gitignored) and fill in. Everything prefixed EXPO_PUBLIC_ is
# inlined into the JS bundle at build time, so only *publishable* values belong
# here — never a RevenueCat secret key, never a Supabase service_role key.

# ── Supabase ────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Mapbox ──────────────────────────────────────────────────────────────────
# Publishable token (pk....) for map tiles, geocoding search and directions.
# `constants/mapbox.ts` falls back to a bundled token when this is unset, so
# the app runs without it — set it to use your own account's quota.
#
# The POI layer behind the Filters panel and the Café Finder does NOT read this.
# It is served by the `places-nearby` edge function, which needs its own
# server-side secret:
#
#   supabase secrets set MAPBOX_ACCESS_TOKEN=pk....
#
# Keep the two separate even if the value is the same, so the server's POI
# spend can be scoped or rotated without shipping a new app build.
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# ── RevenueCat ──────────────────────────────────────────────────────────────
# Public SDK keys, one per platform. RevenueCat Dashboard → Project Settings →
# API keys → "App specific keys". These identify the app and are safe in the
# bundle; the *secret* key (used by the webhook) never leaves the server.
#
# Which key the app uses is decided in `lib/purchases.ts`: the platform key
# wins whenever it is set, so adding these switches a build off the Test Store
# with no code change.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_YOUR_IOS_KEY
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_YOUR_ANDROID_KEY

# OPTIONAL — RevenueCat Test Store key (starts with `test_`).
#
# The Test Store routes purchases to RevenueCat's own sandbox instead of the
# App Store / Google Play, so offerings, paywalls, purchases, entitlements and
# the Customer Center can all be exercised before a single store product
# exists. Requires react-native-purchases >= 9.5.4 (we ship 10.4.x).
#
# It is DEVELOPMENT ONLY. `lib/purchases.ts` refuses to configure with a
# `test_` key in a release build (`__DEV__ === false`) — RevenueCat's own rule
# is that an app submitted to either store must never carry one. Leaving this
# set is safe; a release build simply ignores it.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_YOUR_TEST_STORE_KEY
