<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares that Driverse is a car app built on the Car App Library templates.

  Referenced from the manifest as

      <meta-data
          android:name="com.google.android.gms.car.application"
          android:resource="@xml/automotive_app_desc" />

  and read by the Android Auto host BEFORE it will offer the app on the car
  display at all. Without it, `DriverseCarAppService` is a perfectly valid
  service that nothing ever binds to — which presents as "the app does not
  appear in the car's launcher" with no error anywhere to explain why.

  `<uses name="template"/>` is the declaration that this app draws through the
  Car App Library rather than through the older projected-media or messaging
  paths. The Navigation *category* is not declared here — it comes from the
  `androidx.car.app.category.NAVIGATION` intent filter on the service, and an
  app gets exactly one.
-->
<automotiveApp>
    <uses name="template" />
</automotiveApp>
