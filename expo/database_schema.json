{
  "companyRegistrations": {
    "description": "Complete company registration data structure for Supabase database",
    "table_name": "company_registrations",
    "columns": {
      "id": {
        "type": "uuid",
        "primary_key": true,
        "default": "gen_random_uuid()"
      },
      "owner_id": {
        "type": "uuid",
        "foreign_key": "auth.users(id)",
        "not_null": true,
        "description": "User ID of the company owner"
      },
      "status": {
        "type": "text",
        "check": "status IN ('draft', 'submitted', 'under_review', 'approved', 'rejected', 'requires_revision')",
        "default": "'draft'",
        "not_null": true
      },
      "submitted_at": {
        "type": "bigint",
        "description": "Unix timestamp of submission"
      },
      "reviewed_at": {
        "type": "bigint",
        "description": "Unix timestamp of review completion"
      },
      "approved_at": {
        "type": "bigint",
        "description": "Unix timestamp of approval"
      },
      "reviewed_by": {
        "type": "uuid",
        "foreign_key": "auth.users(id)",
        "description": "Admin user who reviewed the registration"
      },
      "rejection_reason": {
        "type": "text",
        "description": "Reason for rejection if status is rejected"
      },
      "revision_notes": {
        "type": "text",
        "description": "Notes for required revisions"
      },
      "company_info": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "name": "string (required)",
          "business_registration_number": "string (required)",
          "tax_id": "string (required)",
          "email": "string (required)",
          "phone": "string (required)",
          "address": {
            "street": "string (required)",
            "city": "string (required)",
            "province": "string (required)",
            "postal_code": "string (required)",
            "country": "string (default: Indonesia)"
          },
          "website": "string (optional)",
          "established_year": "string (required)",
          "employee_count": "string (required, enum: 1-10, 11-50, 51-100, 100+)"
        }
      },
      "contact_person": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "full_name": "string (required)",
          "position": "string (required)",
          "phone": "string (required)",
          "email": "string (required)",
          "id_number": "string (required, KTP number)"
        }
      },
      "documents": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "business_license": "string (required, document URI)",
          "company_registration": "string (required, document URI)",
          "tax_certificate": "string (required, document URI)",
          "insurance_certificate": "string (optional, document URI)",
          "operating_permit": "string (optional, document URI)",
          "contact_person_id": "string (required, document URI)"
        }
      },
      "fleet": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "total_vehicles": "number (required)",
          "vehicles": [
            {
              "id": "string (required)",
              "type": "string (required, enum: flatbed, hook_chain, wheel_lift, heavy_duty, motorcycle_carrier, integrated, other)",
              "brand": "string (required)",
              "model": "string (required)",
              "year": "string (required)",
              "license_plate": "string (required)",
              "capacity": "string (required)",
              "photos": ["string (document URIs)"],
              "registration_document": "string (required, STNK URI)",
              "insurance_document": "string (required, insurance URI)",
              "is_active": "boolean (default: true)"
            }
          ],
          "maintenance_schedule": "string (required, enum: weekly, monthly, quarterly)",
          "has_insurance": "boolean (required)",
          "insurance_provider": "string (optional)"
        }
      },
      "drivers": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "total_drivers": "number (required)",
          "full_time_drivers": "number (required)",
          "part_time_drivers": "number (required)",
          "freelance_drivers": "number (required)",
          "driver_training_program": "boolean (required)",
          "driver_certification_required": "boolean (required)"
        }
      },
      "services": {
        "type": "jsonb",
        "not_null": true,
        "structure": [
          {
            "id": "string (required)",
            "name": "string (required)",
            "description": "string (required)",
            "is_offered": "boolean (required)",
            "pricing": {
              "base_price": "number (optional)",
              "price_per_km": "number (optional)",
              "minimum_charge": "number (optional)"
            }
          }
        ]
      },
      "pricing": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "model": "string (required, enum: per_km, per_trip, hourly, custom)",
          "base_rate": "number (required)",
          "per_km_rate": "number (optional)",
          "minimum_fee": "number (required)",
          "emergency_multiplier": "number (required, default: 1.5)",
          "night_time_multiplier": "number (required, default: 1.2)",
          "holiday_multiplier": "number (required, default: 1.3)",
          "insurance_partner_discount": "number (required, default: 10)"
        }
      },
      "payment_methods": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "accepts_cash": "boolean (required)",
          "accepts_card": "boolean (required)",
          "accepts_e_wallet": "boolean (required)",
          "accepts_bank_transfer": "boolean (required)",
          "preferred_e_wallets": ["string (array of e-wallet names)"]
        }
      },
      "operations": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "service_areas": ["string (array of cities/regions)"],
          "operating_hours": {
            "is_24x7": "boolean (required)",
            "weekday_start": "string (optional, HH:MM format)",
            "weekday_end": "string (optional, HH:MM format)",
            "weekend_start": "string (optional, HH:MM format)",
            "weekend_end": "string (optional, HH:MM format)"
          },
          "emergency_hotline": "string (required)",
          "response_time": {
            "urban": "number (required, minutes)",
            "suburban": "number (required, minutes)",
            "rural": "number (required, minutes)"
          },
          "has_gps_tracking": "boolean (required)",
          "has_fleet_management": "boolean (required)",
          "fleet_management_software": "string (optional)"
        }
      },
      "bank_info": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "bank_name": "string (required)",
          "account_holder_name": "string (required)",
          "account_number": "string (required)",
          "branch_name": "string (optional)",
          "swift_code": "string (optional)"
        }
      },
      "technology": {
        "type": "jsonb",
        "structure": {
          "has_driver_app": "boolean (required)",
          "driver_app_name": "string (optional)",
          "has_customer_app": "boolean (required)",
          "customer_app_name": "string (optional)",
          "integrates_with_towing_online": "boolean (required, default: true)",
          "api_integration_capable": "boolean (required)",
          "gps_tracking_provider": "string (optional)"
        }
      },
      "references": {
        "type": "jsonb",
        "structure": {
          "insurance_partners": ["string (array of insurance company names)"],
          "corporate_clients": ["string (array of corporate client names)"],
          "government_contracts": "boolean (required)",
          "previous_experience": "string (required, years of experience)"
        }
      },
      "agreements": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "agreed_to_terms": "boolean (required)",
          "agreed_to_data_processing": "boolean (required)",
          "agreed_to_quality_standards": "boolean (required)",
          "agreed_to_commission_structure": "boolean (required)",
          "signed_mou": "boolean (required)"
        }
      },
      "created_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      },
      "updated_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      }
    },
    "indexes": [
      {
        "name": "idx_company_registrations_owner_id",
        "columns": ["owner_id"]
      },
      {
        "name": "idx_company_registrations_status",
        "columns": ["status"]
      },
      {
        "name": "idx_company_registrations_submitted_at",
        "columns": ["submitted_at"]
      }
    ],
    "row_level_security": {
      "enabled": true,
      "policies": [
        {
          "name": "Users can view their own registrations",
          "operation": "SELECT",
          "condition": "auth.uid() = owner_id"
        },
        {
          "name": "Users can insert their own registrations",
          "operation": "INSERT",
          "condition": "auth.uid() = owner_id"
        },
        {
          "name": "Users can update their own draft registrations",
          "operation": "UPDATE",
          "condition": "auth.uid() = owner_id AND status = 'draft'"
        },
        {
          "name": "Admins can view all registrations",
          "operation": "SELECT",
          "condition": "auth.jwt() ->> 'role' = 'admin'"
        },
        {
          "name": "Admins can update registration status",
          "operation": "UPDATE",
          "condition": "auth.jwt() ->> 'role' = 'admin'"
        }
      ]
    }
  },
  "companies": {
    "description": "Approved companies table",
    "table_name": "companies",
    "columns": {
      "id": {
        "type": "uuid",
        "primary_key": true,
        "default": "gen_random_uuid()"
      },
      "registration_id": {
        "type": "uuid",
        "foreign_key": "company_registrations(id)",
        "not_null": true,
        "unique": true
      },
      "owner_id": {
        "type": "uuid",
        "foreign_key": "auth.users(id)",
        "not_null": true
      },
      "name": {
        "type": "text",
        "not_null": true
      },
      "business_license": {
        "type": "text",
        "not_null": true
      },
      "tax_id": {
        "type": "text",
        "not_null": true,
        "unique": true
      },
      "email": {
        "type": "text",
        "not_null": true
      },
      "phone": {
        "type": "text",
        "not_null": true
      },
      "address": {
        "type": "jsonb"
      },
      "verification_status": {
        "type": "text",
        "check": "verification_status IN ('pending', 'verified', 'rejected')",
        "default": "'verified'",
        "not_null": true
      },
      "is_active": {
        "type": "boolean",
        "default": true,
        "not_null": true
      },
      "total_revenue": {
        "type": "numeric",
        "default": 0
      },
      "monthly_revenue": {
        "type": "numeric",
        "default": 0
      },
      "driver_count": {
        "type": "integer",
        "default": 0
      },
      "rating": {
        "type": "numeric",
        "default": 5.0
      },
      "total_jobs": {
        "type": "integer",
        "default": 0
      },
      "completed_jobs": {
        "type": "integer",
        "default": 0
      },
      "created_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      },
      "updated_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      }
    },
    "indexes": [
      {
        "name": "idx_companies_owner_id",
        "columns": ["owner_id"]
      },
      {
        "name": "idx_companies_verification_status",
        "columns": ["verification_status"]
      },
      {
        "name": "idx_companies_is_active",
        "columns": ["is_active"]
      }
    ]
  },
  "company_vehicles": {
    "description": "Company fleet vehicles",
    "table_name": "company_vehicles",
    "columns": {
      "id": {
        "type": "uuid",
        "primary_key": true,
        "default": "gen_random_uuid()"
      },
      "company_id": {
        "type": "uuid",
        "foreign_key": "companies(id)",
        "not_null": true
      },
      "type": {
        "type": "text",
        "check": "type IN ('flatbed', 'hook_chain', 'wheel_lift', 'heavy_duty', 'motorcycle_carrier', 'integrated', 'other')",
        "not_null": true
      },
      "brand": {
        "type": "text",
        "not_null": true
      },
      "model": {
        "type": "text",
        "not_null": true
      },
      "year": {
        "type": "text",
        "not_null": true
      },
      "license_plate": {
        "type": "text",
        "not_null": true,
        "unique": true
      },
      "capacity": {
        "type": "text",
        "not_null": true
      },
      "photos": {
        "type": "jsonb",
        "default": "[]"
      },
      "registration_document": {
        "type": "text"
      },
      "insurance_document": {
        "type": "text"
      },
      "is_active": {
        "type": "boolean",
        "default": true,
        "not_null": true
      },
      "created_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      },
      "updated_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      }
    },
    "indexes": [
      {
        "name": "idx_company_vehicles_company_id",
        "columns": ["company_id"]
      },
      {
        "name": "idx_company_vehicles_license_plate",
        "columns": ["license_plate"]
      }
    ]
  },
  "company_drivers": {
    "description": "Drivers linked to companies",
    "table_name": "company_drivers",
    "columns": {
      "id": {
        "type": "uuid",
        "primary_key": true,
        "default": "gen_random_uuid()"
      },
      "driver_id": {
        "type": "uuid",
        "foreign_key": "drivers(id)",
        "not_null": true
      },
      "company_id": {
        "type": "uuid",
        "foreign_key": "companies(id)",
        "not_null": true
      },
      "joined_at": {
        "type": "bigint",
        "not_null": true
      },
      "is_active": {
        "type": "boolean",
        "default": true,
        "not_null": true
      },
      "permissions": {
        "type": "jsonb",
        "default": "{\"can_accept_requests\": true, \"can_view_earnings\": true}"
      },
      "payout_settings": {
        "type": "jsonb",
        "default": "{\"percentage\": 70, \"payout_schedule\": \"weekly\"}"
      },
      "created_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      },
      "updated_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      }
    },
    "indexes": [
      {
        "name": "idx_company_drivers_driver_id",
        "columns": ["driver_id"]
      },
      {
        "name": "idx_company_drivers_company_id",
        "columns": ["company_id"]
      }
    ],
    "unique_constraints": [
      {
        "name": "unique_driver_company",
        "columns": ["driver_id", "company_id"]
      }
    ]
  },
  "chat_messages": {
    "description": "Real-time chat messages between users and drivers",
    "table_name": "chat_messages",
    "columns": {
      "id": {
        "type": "uuid",
        "primary_key": true,
        "default": "gen_random_uuid()"
      },
      "tow_request_id": {
        "type": "uuid",
        "not_null": true,
        "description": "Reference to the tow request this chat belongs to"
      },
      "sender_id": {
        "type": "uuid",
        "foreign_key": "auth.users(id)",
        "not_null": true,
        "description": "User who sent the message"
      },
      "receiver_id": {
        "type": "uuid",
        "foreign_key": "auth.users(id)",
        "not_null": true,
        "description": "User who should receive the message"
      },
      "message_type": {
        "type": "text",
        "check": "message_type IN ('text', 'location', 'system', 'image', 'status_update')",
        "default": "'text'",
        "not_null": true
      },
      "content": {
        "type": "text",
        "not_null": true,
        "description": "Message content or system message"
      },
      "metadata": {
        "type": "jsonb",
        "description": "Additional data like location coordinates, image URLs, etc."
      },
      "is_read": {
        "type": "boolean",
        "default": false,
        "not_null": true
      },
      "read_at": {
        "type": "timestamp with time zone",
        "description": "When the message was read"
      },
      "created_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      },
      "updated_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      }
    },
    "indexes": [
      {
        "name": "idx_chat_messages_tow_request_id",
        "columns": ["tow_request_id"]
      },
      {
        "name": "idx_chat_messages_sender_id",
        "columns": ["sender_id"]
      },
      {
        "name": "idx_chat_messages_receiver_id",
        "columns": ["receiver_id"]
      },
      {
        "name": "idx_chat_messages_created_at",
        "columns": ["created_at"]
      },
      {
        "name": "idx_chat_messages_is_read",
        "columns": ["is_read"]
      }
    ],
    "row_level_security": {
      "enabled": true,
      "policies": [
        {
          "name": "Users can view messages they sent or received",
          "operation": "SELECT",
          "condition": "auth.uid() = sender_id OR auth.uid() = receiver_id"
        },
        {
          "name": "Users can insert messages they are sending",
          "operation": "INSERT",
          "condition": "auth.uid() = sender_id"
        },
        {
          "name": "Users can update read status of messages they received",
          "operation": "UPDATE",
          "condition": "auth.uid() = receiver_id AND OLD.sender_id = sender_id AND OLD.content = content"
        }
      ]
    }
  },
  "tow_requests": {
    "description": "Towing service requests",
    "table_name": "tow_requests",
    "columns": {
      "id": {
        "type": "uuid",
        "primary_key": true,
        "default": "gen_random_uuid()"
      },
      "customer_id": {
        "type": "uuid",
        "foreign_key": "auth.users(id)",
        "not_null": true
      },
      "driver_id": {
        "type": "uuid",
        "foreign_key": "auth.users(id)",
        "description": "Assigned driver (null when pending)"
      },
      "company_id": {
        "type": "uuid",
        "foreign_key": "companies(id)",
        "description": "Company handling the request"
      },
      "pickup_location": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "latitude": "number (required)",
          "longitude": "number (required)",
          "address": "string (required)"
        }
      },
      "dropoff_location": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "latitude": "number (required)",
          "longitude": "number (required)",
          "address": "string (required)"
        }
      },
      "vehicle_info": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "make": "string (required)",
          "model": "string (required)",
          "color": "string (required)",
          "license_plate": "string (required)",
          "photos": "array of strings (URIs)"
        }
      },
      "breakdown_info": {
        "type": "jsonb",
        "not_null": true,
        "structure": {
          "type": "string (required, enum: engine_wont_start, accident, flat_tire, stuck, battery_dead, overheating, other)",
          "notes": "string (optional)"
        }
      },
      "service_type": {
        "type": "text",
        "check": "service_type IN ('hydraulic', 'ladder', 'accident', 'service', 'double_deck')",
        "default": "'ladder'",
        "not_null": true
      },
      "status": {
        "type": "text",
        "check": "status IN ('pending', 'accepted', 'in_progress', 'completed', 'cancelled')",
        "default": "'pending'",
        "not_null": true
      },
      "distance_km": {
        "type": "numeric",
        "not_null": true,
        "description": "Distance in kilometers"
      },
      "price_idr": {
        "type": "numeric",
        "not_null": true,
        "description": "Price in Indonesian Rupiah"
      },
      "payment_status": {
        "type": "text",
        "check": "payment_status IN ('pending', 'paid', 'failed', 'refunded')",
        "default": "'pending'",
        "not_null": true
      },
      "payment_transaction_id": {
        "type": "uuid",
        "description": "Reference to payment transaction"
      },
      "driver_location": {
        "type": "jsonb",
        "description": "Current driver location for tracking"
      },
      "estimated_arrival": {
        "type": "timestamp with time zone",
        "description": "Estimated driver arrival time"
      },
      "accepted_at": {
        "type": "timestamp with time zone"
      },
      "started_at": {
        "type": "timestamp with time zone"
      },
      "completed_at": {
        "type": "timestamp with time zone"
      },
      "cancelled_at": {
        "type": "timestamp with time zone"
      },
      "cancellation_reason": {
        "type": "text"
      },
      "rating": {
        "type": "integer",
        "check": "rating >= 1 AND rating <= 5",
        "description": "Customer rating (1-5 stars)"
      },
      "review": {
        "type": "text",
        "description": "Customer review text"
      },
      "created_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      },
      "updated_at": {
        "type": "timestamp with time zone",
        "default": "now()",
        "not_null": true
      }
    },
    "indexes": [
      {
        "name": "idx_tow_requests_customer_id",
        "columns": ["customer_id"]
      },
      {
        "name": "idx_tow_requests_driver_id",
        "columns": ["driver_id"]
      },
      {
        "name": "idx_tow_requests_company_id",
        "columns": ["company_id"]
      },
      {
        "name": "idx_tow_requests_status",
        "columns": ["status"]
      },
      {
        "name": "idx_tow_requests_payment_status",
        "columns": ["payment_status"]
      },
      {
        "name": "idx_tow_requests_created_at",
        "columns": ["created_at"]
      }
    ],
    "row_level_security": {
      "enabled": true,
      "policies": [
        {
          "name": "Customers can view their own requests",
          "operation": "SELECT",
          "condition": "auth.uid() = customer_id"
        },
        {
          "name": "Drivers can view requests assigned to them",
          "operation": "SELECT",
          "condition": "auth.uid() = driver_id"
        },
        {
          "name": "Drivers can view pending requests for assignment",
          "operation": "SELECT",
          "condition": "status = 'pending' AND driver_id IS NULL"
        },
        {
          "name": "Customers can create requests",
          "operation": "INSERT",
          "condition": "auth.uid() = customer_id"
        },
        {
          "name": "Customers can update their own pending requests",
          "operation": "UPDATE",
          "condition": "auth.uid() = customer_id AND OLD.status = 'pending'"
        },
        {
          "name": "Drivers can accept pending requests",
          "operation": "UPDATE",
          "condition": "OLD.status = 'pending' AND status = 'accepted' AND auth.uid() = driver_id"
        },
        {
          "name": "Drivers can update status of their assigned requests",
          "operation": "UPDATE",
          "condition": "auth.uid() = driver_id AND OLD.driver_id = driver_id"
        }
      ]
    }
  }
}