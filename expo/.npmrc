# BUILD SAFETY — npm must not refuse this tree.
#
# `npm install` FAILED on this repository for every build between at least
# 1 and 3 August 2026, and that is the most likely reason five consecutive
# dependency fixes never reached an Android APK: an installer that errors
# leaves whatever `node_modules` was already there, so the build shipped a
# cached `expo-web-browser` 56.x no matter what `package.json` said.
#
# Two separate failures were in the way. `EOVERRIDE` came from `overrides`
# entries whose spec did not match their own `dependencies` entry — fixed in
# package.json by pinning exactly and using npm's `$name` reference. This file
# handles the other one: `ERESOLVE`, from peer ranges that predate React 19.
#
#   lucide-react-native@0.475.0  peers react ^16.5.1 || ^17 || ^18
#   (react 19.1.0 is installed; the icons work fine — the metadata is stale)
#
# `legacy-peer-deps` restores npm 6 behaviour: install the tree, warn about
# peers, do not refuse. That is already what bun does, and bun's tree is what
# every green CI run, every passing test and every working iOS build has been
# built from. This makes npm agree rather than changing what ships.
#
# The alternative — bumping lucide-react-native from 0.475.0 to 1.x for its
# React 19 peer range — is a major version jump across every icon in the app,
# and is not something to do in the same change as a launch-crash fix. Worth
# doing deliberately, later, on its own.
legacy-peer-deps=true
