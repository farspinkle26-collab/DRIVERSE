# Driveverse Admin Dashboard — environment variables
# Copy to .env.local for local dev. In production set these as Vercel
# Environment Variables (Project Settings → Environment Variables) — NEVER commit real values.

# Supabase project URL (same backend as the Driveverse mobile app)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# READ-ONLY access to the database. Two options:
#  (a) the service_role key (bypasses RLS so the dashboard can aggregate across
#      all users). It is used ONLY in server code here and never sent to the
#      browser — but treat it as a full-access secret.
#  (b) RECOMMENDED before wider access: a dedicated read-only Postgres role with
#      BYPASSRLS + SELECT-only grants, exposed via a PostgREST key. Swap the value
#      below for that key when you create it.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-READONLY-KEY

# Single shared password that gates the whole /admin dashboard.
# TEMPORARY: this is a shared-secret gate for the founding team only. Move to
# real auth with per-user roles before granting access to anyone else.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Secret used to sign the admin session cookie. Any long random string.
ADMIN_SESSION_SECRET=another-long-random-string
